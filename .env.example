TELEGRAM_BOT_TOKEN=
# Comma-separated to notify more than one chat, e.g. 111111,222222 --
# every recipient gets identical alerts, including purchase attempts.
TELEGRAM_CHAT_ID=

# Auto-checkout (optional -- leave unset to keep notify-only behavior).
# Uses the payment method already saved on the AMC account. AMC_CVV is
# the one exception to "no card data" -- AMC occasionally re-prompts for
# the saved card's CVV, and there's no way past that without it. See
# README's Security section before setting AMC_AUTO_PURCHASE=true.
# AMC_EMAIL=
# AMC_PASSWORD=
# AMC_CVV=
# AMC_AUTO_PURCHASE=false

# Optional overrides -- defaults in amc_monitor/config.py already point at
# Odyssey / AMC Lincoln Square 13 / IMAX 70mm.
# AMC_MOVIE_SLUG=
# AMC_THEATRE_SLUG=
# AMC_FORMAT_SLUG=
